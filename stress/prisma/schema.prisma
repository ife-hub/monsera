model Transactions {
  id                Int        @id @default(autoincrement())
  date              DateTime
  transactionId     String     @unique
  branch            String     // meterToken — pseudonymised identifier from DisCo
  amount            Decimal    // DEPRECATED: use obligationKobo / disbursedKobo / serviceKobo

  obligationKobo    Int?       // full amount customer must repay (naira * 100)
  disbursedKobo     Int?       // tokens issued = floor(obligation * 10000 / (10000 + rateBps))
  serviceKobo       Int?       // service charge = obligationKobo - disbursedKobo
  rateBps           Int?       // rate at transaction time e.g. 1000 = 10%. Persisted, never retroactively altered.

  transactionType   String
  transactionStatus String
  paymentStatus     String
  customerId        Int
  aggregatorId      Int?
  discoAdminId      Int
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @default(now())
  aggregator        Aggregator? @relation(fields: [aggregatorId], references: [id])
  discoAdmin        DiscoAdmin  @relation(fields: [discoAdminId], references: [id])
  customer          Customer    @relation(fields: [customerId], references: [id])
  obligations       Obligation[]
  monseraEarnings   MonseraEarnings[]

  @@index([customerId, aggregatorId, paymentStatus])
  @@index([transactionType, transactionStatus, paymentStatus])
}

model Obligation {
  id                  Int                   @id @default(autoincrement())
  transactionId       Int                   // links to the originating debit transaction
  transaction         Transactions          @relation(fields: [transactionId], references: [id])
  meterToken          String                // pseudonymised meter identifier
  customerId          Int
  customer            Customer              @relation(fields: [customerId], references: [id])
  discoAdminId        Int
  discoAdmin          DiscoAdmin            @relation(fields: [discoAdminId], references: [id])

  // Amounts — all integer kobo
  obligationKobo      Int                   // original full obligation
  disbursedKobo       Int                   // tokens issued at disbursement
  serviceKobo         Int                   // service charge component
  remainingKobo       Int                   // decrements on partial recovery; 0 = fully discharged
  rateBps             Int                   // rate at disbursement time

  status              ObligationStatus      @default(Current)
  band                TariffBand            // A, B, or C — determines daily burn rate
  disbursementDate    DateTime              // start of elapsed clock
  expectedRecoveryDate DateTime             // computed at disbursement
  watchDate           DateTime              // threshold for Watch status
  delayedDate         DateTime              // threshold for Delayed status
  defaultDate         DateTime              // threshold for Default status

  windowParameterVersion String?           // RecoveryWindowParameters.version used to compute the dates above
  clockSuspended      Boolean               @default(false)
  suspendedDays       Int                   @default(0) // accumulated suspended days

  // Recovery tracking
  recoveredKobo       Int                   @default(0)
  principalRecoveredKobo Int               @default(0)
  serviceRecoveredKobo   Int               @default(0)

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now())
  suspensions         ObligationSuspension[]
  recoveries          ObligationRecovery[]

  @@index([meterToken, status])
  @@index([customerId, status])
  @@index([status, defaultDate])
}

model ObligationSuspension {
  id            Int         @id @default(autoincrement())
