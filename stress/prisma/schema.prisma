  createdAt     DateTime    @default(now())
}

model ObligationRecovery {
  id                    Int         @id @default(autoincrement())
  obligationId          Int
  obligation            Obligation  @relation(fields: [obligationId], references: [id])
  recoveryTransactionId Int         // links to the credit/repayment transaction
  amountKobo            Int         // total recovered in this event
  principalKobo         Int         // principal component
  serviceKobo           Int         // service charge component
  walletBRecordId       Int?        // links to WalletTransaction in Wallet B
  sweptAt               DateTime?   // set when the principal was swept B -> A; null = not yet swept
  createdAt             DateTime    @default(now())

  @@index([sweptAt])
}

model DecisionLog {
  id                  Int       @id @default(autoincrement())
  decisionId          String    @unique  // unique reference for this decision
  meterToken          String             // pseudonymised identifier as supplied by DisCo
  band                String             // tariff band at decision time
  features            Json               // complete feature vector with named values
  modelVersion        String             // scoring model version applied
  parameterVersion    String             // credit parameter envelope version
  decision            String             // approved | declined
  declineReason       String?            // where applicable
  approvedLimitKobo   Int?               // where approved
  requestedKobo       Int                // obligation requested
  latencyMs           Int                // scoring call duration
  timestampUtc        DateTime           // decision time
  correlationId       String?            // ties decision to resulting transaction
  createdAt           DateTime           @default(now())

  @@index([meterToken])
  @@index([correlationId])
}

