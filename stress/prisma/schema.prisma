}

model VendRecord {
  id               Int                  @id @default(autoincrement())
  discoAdminId     Int
  discoAdmin       DiscoAdmin           @relation(fields: [discoAdminId], references: [id])
  partnerVendId    String
  meterToken       String
  amountKobo       Int
  vendType         VendType
  vendStatus       VendStatus
  vendedAt         DateTime
  receivedAt       DateTime             @default(now())
  processingStatus VendProcessingStatus @default(Pending)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  revisions        VendRecordRevision[]

  @@unique([discoAdminId, partnerVendId])
  @@index([meterToken, vendedAt])
  @@index([discoAdminId, processingStatus])
}

model VendRecordRevision {
  id                  Int        @id @default(autoincrement())
  vendRecordId        Int
  vendRecord          VendRecord @relation(fields: [vendRecordId], references: [id])
  previousAmountKobo  Int
  newAmountKobo       Int
  previousVendType    VendType
  newVendType         VendType
  previousVendStatus  VendStatus
  newVendStatus       VendStatus
  previousVendedAt    DateTime
  newVendedAt         DateTime
  createdAt           DateTime   @default(now())

  @@index([vendRecordId])
}

model VendIngestionFailure {
  id                     Int        @id @default(autoincrement())
