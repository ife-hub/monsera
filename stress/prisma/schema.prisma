model CreditParameters {
  id                    Int      @id @default(autoincrement())
  version               String   @unique
  rateBps               Int      // service charge rate e.g. 1000 = 10%
  minObligationKobo     Int      // minimum advance e.g. 200000 = N2,000
  maxObligationKobo     Int      // maximum advance e.g. 700000 = N7,000
  maxConcurrentObligations Int   // 1 = meter may not hold more than one outstanding obligation
  obligationTiersKobo   Int[]    @default([]) // permitted obligation amounts, e.g. {200000,400000,700000}; empty = any amount within min/max
  isActive              Boolean  @default(true)
  effectiveFrom         DateTime
  createdAt             DateTime @default(now())
}

/// Spec §5.2 threshold configuration. Recalibrated monthly without a code
/// deployment. Each obligation's windows are computed once, at disbursement,
/// with the parameters in force then (windowParameterVersion on Obligation).
model RecoveryWindowParameters {
  id                Int      @id @default(autoincrement())
  version           String   @unique
  watchMultiplier   Decimal  @db.Decimal(6, 3) // watch_days   = max(round(m * E), minWatchDays)
  delayedMultiplier Decimal  @db.Decimal(6, 3) // delayed_days = max(round(m * E), minDelayedDays)
  defaultMultiplier Decimal  @db.Decimal(6, 3) // default_days = min(max(round(m * E), minDefaultDays), maxDefaultDays)
  minWatchDays      Int
  minDelayedDays    Int
  minDefaultDays    Int
  maxDefaultDays    Int
  isActive          Boolean  @default(true)
  effectiveFrom     DateTime
  createdAt         DateTime @default(now())
}

/// Spec §3.2 participating cohort: the ring-fenced meters APLE has shared.
/// A meter not present (or removed) is declined before any scoring call.
model CohortMeter {
  id         Int       @id @default(autoincrement())
  meterToken String    @unique
  source     String?   // e.g. the APLE file the token was imported from
  addedAt    DateTime  @default(now())
  removedAt  DateTime? // ring-fence released for this meter; null = in cohort
}

/// Outcome of each reconciliation run (spec §8), so settlement can require a
/// passed run for its period and results are auditable.
model ReconciliationRun {
  id        Int      @id @default(autoincrement())
  kind      String   // daily | monthly
  period    String   // YYYY-MM-DD (daily) or YYYY-MM (monthly), WAT
  passed    Boolean
  details   Json
  createdAt DateTime @default(now())

  @@index([kind, period])
}

model BurnRate {
  id           Int        @id @default(autoincrement())
  band         TariffBand
  dailyBurnNaira Int      // e.g. 1100 for Band A
  effectiveFrom DateTime
  createdAt    DateTime   @default(now())
}

