# ── Shared by every service (docker compose reads this file as .env) ──────
# Copy to .env and replace every value marked CHANGE ME. Never commit .env.

DATABASE_URL=postgresql://monsera:monsera@postgres:5432/monsera
REDIS_URL=redis://redis:6379
# Keeps environments that share one Redis apart (e.g. staging on the live
# Redis). Must be the same for every service in one environment.
BULLMQ_PREFIX=bull

# Signs and verifies sign-in tokens. Same value in gateway and all services.
JWT_SECRET=CHANGE-ME-generate-with-openssl-rand-base64-48

# ── monsera-payments ───────────────────────────────────────────────────────
WALLET_A_ID=1
WALLET_B_ID=2
WALLET_C_ID=3
# Wallet A is split into this many rows (itself + sub-wallets) so several
# advances can pay out at once. 1 turns the split off. Default 8.
# WALLET_A_SHARDS=8
# Disco/aggregator totals are updated from pending changes this often (ms).
# PARTNER_TOTALS_FOLD_MS=2000
SCORING_ENGINE_URL=http://mock-scoring:4001
SCORING_ENGINE_SECRET=
# Protects the manual job endpoints (/api/cron/*).
CRON_SECRET=CHANGE-ME
# Optional: move or switch off a scheduled job (cron pattern in WAT, or "off").
# CRON_DAILY_SWEEP=15 0 * * *
# CRON_WALLET_A_REBALANCE=*/10 * * * *
# RUN_WORKERS=false   # on instances that should only serve HTTP

# ── monsera-vend-ingestion ─────────────────────────────────────────────────
NOTIFICATIONS_URL=http://notifications:3005
# CRON_VEND_FAILURE_REPORT=0 3 * * *

# ── monsera-vend-ingestion + monsera-notifications ────────────────────────
# Shared secret for service-to-service calls to notifications.
INTERNAL_API_KEY=CHANGE-ME

# ── monsera-gateway ────────────────────────────────────────────────────────
PAYMENTS_URL=http://payments:3001
USERS_ADMIN_URL=http://users-admin:3002
VEND_INGESTION_URL=http://vend-ingestion:3003
ADMIN_URL=http://admin:3004
CORS_ORIGINS=https://app.plugmonsera.com,https://monsera-frontend-pwjpq.ondigitalocean.app,http://localhost:3000
# RATE_LIMIT_PER_MINUTE=1200
# TRUST_PROXY_HOPS=1

# ── monsera-notifications ──────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Monsera <no-reply@plugmonsera.com>
ALERT_RECIPIENTS=
ALERT_PHONE_NUMBERS=

# ── Optional monitoring (any service) ──────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=
